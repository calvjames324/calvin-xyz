---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<section class="mt-10 pb-4 space-y-8 max-w-full font-body">
	{posts.map((post) => (
		<a href={`/blog/${post.id}/`} class="block group no-underline max-w-full">
			<h3 class="text-[1.4rem] leading-snug font-normal text-(--primary) break-words font-body group-hover:underline underline-offset-4">
				{post.data.title}
			</h3>
			<p class="mt-2 text-[1rem] leading-relaxed text-(--ink-muted) font-body">
				{post.data.description}
			</p>
		</a>
	))}
</section>
