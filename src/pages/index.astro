---
import Base from '../layouts/Base.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import '../styles/global.css';
import LifeUpdates from '../layouts/LifeUpdates.astro'
import HomeBlogIndex from '../components/home/HomeBlogIndex.astro'
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
    <div class="mt-8">
        <div class='mt-2 mb-12 flex flex-col items-center gap-6'>
            <div class='flex items-center justify-center gap-8 max-[450px]:gap-5'>
                <img src="/flower.svg" alt="Flower illustration" class="w-24 shrink-0 opacity-90 invert max-[450px]:w-16" />
                <img src="/meditate.svg" alt="Meditation illustration" class="w-32 h-32 shrink-0 opacity-90 invert max-[450px]:w-24 max-[450px]:h-24" />
                <img src="/flower.svg" alt="Flower illustration" class="w-24 shrink-0 opacity-90 invert scale-x-[-1] max-[450px]:w-16" />
            </div>
            <div class='my-2 text-[1.125rem] leading-relaxed font-body text-left text-(--ink)/75 font-light max-w-2xl w-full'>
            You will find my experiments here. I write paper breakdowns <a href="https://bloginions.netlify.app/" class="underline underline-offset-4">@bloginions</a>. And please pray that i can muster up enough to write a <a href="https://substack.com/@theinductivebias" class="underline underline-offset-4">substack</a> often.
            </div>
        </div>
        <div class='mx-6 max-[479px]:mx-1 h-70 flex'>
            <LifeUpdates/>
        </div>
        <div class='mx-6 max-[479px]:mx-1'>
            <HomeBlogIndex />
        </div>
    </div>
</Base>
