---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Base title={`Blogs | ${SITE_TITLE}`} description="All posts, research and experiments by Calvin.">
	<section class="mt-10 mb-8 max-w-full font-body">
		<h1 class="text-3xl font-semibold text-(--primary)">Blogs</h1>
		<div class="mt-8 space-y-8">
			{posts.map((post) => (
				<a href={`/blog/${post.id}/`} class="block group no-underline max-w-full">
					<h2 class="text-[1.4rem] leading-snug font-normal text-(--primary) break-words font-body group-hover:underline underline-offset-4">
						{post.data.title}
					</h2>
					<p class="mt-2 text-[1rem] leading-relaxed text-(--ink-muted) font-body">
						{post.data.description}
					</p>
				</a>
			))}
		</div>
	</section>
</Base>
